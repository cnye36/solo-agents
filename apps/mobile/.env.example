EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=

# Android emulator + API in WSL2: Windows localhost does not reach the API; set this to your WSL IP.
# Run: pnpm android:print-api-host   (from apps/mobile)
# If the API runs on Windows instead of WSL, use: EXPO_PUBLIC_API_ANDROID_HOST=10.0.2.2
EXPO_PUBLIC_API_ANDROID_HOST=
